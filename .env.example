# 书签管理器配置文件
# 复制此文件为 .env 并修改配置

# 应用配置
DEBUG=True
HOST=0.0.0.0
PORT=9001
SECRET_KEY=your-secret-key-change-in-production

# API 配置
API_VERSION=v1

# 数据存储
DATA_FILE=bookmarks.json
MAX_BACKUP_COUNT=5

# 文件上传
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# 日志配置
LOG_LEVEL=INFO
# LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS 配置
CORS_ORIGINS=*

# 批量处理限制
MAX_BOOKMARKS_PER_BATCH=1000
